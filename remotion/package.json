{
  "name": "signal-studio-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion master composition and timeline integrator",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render:native": "remotion render src/index.ts SignalShowcase ../renders/remotion-native.mp4 --codec=h264 --crf=18",
    "render:integrated": "remotion render src/index.ts IntegratedShowcase ../renders/integrated-showcase.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/media": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "19.0.10",
    "typescript": "5.8.3"
  }
}
